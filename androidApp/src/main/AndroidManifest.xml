<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Other Androsaur apps signed with the same key may start and bind the service. -->
    <permission android:name="dev.hram.androsaur.audio.permission.CONTROL" android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application android:label="Androsaur Звук" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- Hands the local server's access code to apps signed with the same key (see LinkProvider). -->
        <provider android:name=".LinkProvider" android:authorities="dev.hram.androsaur.audio.link" android:exported="true"
            android:permission="dev.hram.androsaur.audio.permission.CONTROL" />
        <service android:name=".AudioService" android:exported="true"
            android:permission="dev.hram.androsaur.audio.permission.CONTROL" android:foregroundServiceType="microphone" />
    </application>
</manifest>
